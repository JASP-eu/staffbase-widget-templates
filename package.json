    "screenshots": "bun scripts/screenshots.ts"
  },
  "devDependencies": {
    "@staffbase/widget-sdk": "3.19.9",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
