{
  "name": "staffbase-widget-templates",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Small Staffbase custom widget templates built on the Staffbase Widget SDK.",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check-types": "tsc --noEmit",
